+++ b/app/src/test/java/top/toneup/word/ui/ExternalImportViewModelTest.kt
@@ -0,0 +1,371 @@
+package top.toneup.word.ui
+
+import android.os.Looper
+import androidx.room.Room
+import androidx.test.core.app.ApplicationProvider
+import org.robolectric.Shadows.shadowOf
+import top.toneup.word.AppContainer
+import top.toneup.word.core.result.AppError
+import top.toneup.word.core.result.Outcome
+import top.toneup.word.data.gateway.LookupResult
+import top.toneup.word.data.local.ToneUpWordDatabase
+import top.toneup.word.data.local.entity.WordPackEntity
+import top.toneup.word.data.repository.BatchReport
+import top.toneup.word.data.repository.MeaningSyncRepository
+import top.toneup.word.data.repository.PackAddResult
+import top.toneup.word.data.settings.PackIds
+import top.toneup.word.data.settings.UserSettings
+import top.toneup.word.domain.model.CetLevel
+import com.google.common.truth.Truth.assertThat
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.cancel
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.flowOf
+import kotlinx.coroutines.runBlocking
+import androidx.lifecycle.viewModelScope
+import org.junit.After
+import org.junit.Before
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+
+/**
+ * The M5 intake ViewModel: parse routing (share vs clipboard), the write path into a pack,
+ * meaning-sync triggering and the clipboard hash bookkeeping (plan §8).
+ *
+ * Runs against a **real in-memory Room database and the real DataStore** through
+ * [AppContainer] — the paste-import write semantics are exactly what the learner depends on
+ * (PENDING rows, no REPLACE), so faking the repository would test nothing. Only
+ * [MeaningSyncRepository] is faked: WorkManager has no test artifact in this project, and
+ * "the worker was enqueued" is asserted through the seam instead.
+ *
+ * Timing model: the ViewModel runs on `Dispatchers.Main.immediate`, which on a Robolectric
+ * test thread executes inline until a real Room / DataStore suspension; the continuation is
+ * posted back to the (paused) main looper and drained by [awaitCondition], whose condition
+ * polls real state. Fixed epoch constants keep the suite flake-free.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [26])
+class ExternalImportViewModelTest {
+
+    /** Records `enqueueAll` calls; everything else is unused by this ViewModel. */
+    private class RecordingMeaningSync : MeaningSyncRepository {
+        var enqueues: Int = 0
+
+        override fun observePendingCount(): Flow<Int> = flowOf(0)
+
+        override suspend fun enqueueAll(): Outcome<Unit> {
+            enqueues++
+            return Outcome.Success(Unit)
+        }
+
+        override suspend fun lookupWordNow(wordId: Long): Outcome<LookupResult> =
+            Outcome.Failure(AppError.unknown("not under test"))
+
+        override suspend fun runBatch(batchLimit: Int): BatchReport =
+            BatchReport(processed = 0, abortedByConfig = false)
+
+        override suspend fun applyLookupToWord(wordId: Long, result: LookupResult, now: Long) = Unit
+    }
+
+    private lateinit var database: ToneUpWordDatabase
+    private lateinit var container: AppContainer
+    private lateinit var meaningSync: RecordingMeaningSync
+    private lateinit var viewModel: ExternalImportViewModel
+
+    private val now = 1_768_450_800_000L
+
+    @Before
+    fun setUp() {
+        val context = ApplicationProvider.getApplicationContext<android.content.Context>()
+        database = Room.inMemoryDatabaseBuilder(
+            ApplicationProvider.getApplicationContext(),
+            ToneUpWordDatabase::class.java,
+        ).allowMainThreadQueries().build()
+        database.openHelper.writableDatabase.execSQL("PRAGMA foreign_keys=ON")
+        container = AppContainer(context, database)
+        // DataStore is shared between tests in the same process; start from a known state.
+        runBlocking(Dispatchers.IO) { container.settingsRepository.resetToDefaults() }
+        meaningSync = RecordingMeaningSync()
+        viewModel = ExternalImportViewModel(container, meaningSync)
+    }
+
+    @After
+    fun tearDown() {
+        // Stop the ViewModel's eager Room/DataStore subscriptions before closing the pool.
+        viewModel.viewModelScope.cancel()
+        database.close()
+    }
+
+    // --- helpers ---------------------------------------------------------------------------
+
+    /**
+     * Drains Robolectric's paused main looper (where ViewModel continuations land) and polls
+     * [condition] until it holds, or fails loudly after a bounded real-time wait.
+     */
+    private fun awaitCondition(description: String, condition: () -> Boolean) {
+        val deadline = System.currentTimeMillis() + TIMEOUT_MILLIS
+        while (!condition()) {
+            if (System.currentTimeMillis() > deadline) {
+                throw AssertionError("timed out waiting for: $description")
+            }
+            shadowOf(Looper.getMainLooper()).idle()
+            Thread.sleep(10)
+        }
+        shadowOf(Looper.getMainLooper()).idle()
+    }
+
+    private fun storedSettings(): UserSettings =
+        runBlocking(Dispatchers.IO) { container.settingsRepository.current() }
+
+    private fun wordIn(packId: String, word: String) =
+        runBlocking(Dispatchers.IO) { database.wordDao().byNormalized(packId, word) }
+
+    private fun countIn(packId: String) =
+        runBlocking(Dispatchers.IO) { database.wordDao().count(packId) }
+
+    private fun awaitPhase(phase: ExternalImportPhase) =
+        awaitCondition("phase == $phase") { viewModel.state.value.phase == phase }
+
+    private fun awaitStoredHash(hash: String) =
+        awaitCondition("lastClipboardHash == $hash") { storedSettings().lastClipboardHash == hash }
+
+    private fun createTestPack(name: String = "测试词库"): String {
+        val outcome = runBlocking(Dispatchers.IO) {
+            container.wordRepository.createPack(name, now)
+        }
+        return requireNotNull(outcome.getOrNull())
+    }
+
+    // --- parse routing ---------------------------------------------------------------------
+
+    @Test
+    fun `shared text becomes a detected preview with honest counts`() {
+        viewModel.onSharedText("apple, banana 中文123")
+
+        val state = viewModel.state.value
+        assertThat(state.phase).isEqualTo(ExternalImportPhase.DETECTED)
+        assertThat(state.source).isEqualTo(ExternalImportSource.SHARE)
+        val preview = requireNotNull(state.preview)
+        assertThat(preview.words).containsExactly("apple", "banana").inOrder()
+        assertThat(preview.importableCount).isEqualTo(2)
+        assertThat(preview.dropped).isEqualTo(1)
+        assertThat(preview.duplicates).isEqualTo(0)
+    }
+
+    @Test
+    fun `blank share text becomes the short error state`() {
+        viewModel.onSharedText("   ")
+
+        val state = viewModel.state.value
+        assertThat(state.phase).isEqualTo(ExternalImportPhase.ERROR)
+        assertThat(state.preview).isNull()
+        assertThat(state.error).isNotNull()
+    }
+
+    @Test
+    fun `fully filtered text becomes the short error state`() {
+        viewModel.onSharedText("中文？？ 123")
+
+        val state = viewModel.state.value
+        assertThat(state.phase).isEqualTo(ExternalImportPhase.ERROR)
+        assertThat(state.preview).isNull()
+        assertThat(state.error).isNotNull()
+    }
+
+    @Test
+    fun `clipboard content without importable words stays silent`() {
+        viewModel.onClipboardText("12345 中文 https://example.com")
+
+        // A junk clipboard must never open the sheet (plan §8.1: 非空才展示).
+        assertThat(viewModel.state.value.phase).isEqualTo(ExternalImportPhase.IDLE)
+        assertThat(viewModel.isSheetVisible()).isFalse()
+    }
+
+    @Test
+    fun `importable clipboard content enters the detected state`() {
+        viewModel.onClipboardText("apple banana")
+
+        val state = viewModel.state.value
+        assertThat(state.phase).isEqualTo(ExternalImportPhase.DETECTED)
+        assertThat(state.source).isEqualTo(ExternalImportSource.CLIPBOARD)
+        assertThat(state.preview?.importableCount).isEqualTo(2)
+        assertThat(viewModel.isSheetVisible()).isTrue()
+    }
+
+    // --- write path ------------------------------------------------------------------------
+
+    @Test
+    fun `confirmImport stores the words as PENDING and triggers meaning completion`() {
+        val packId = createTestPack()
+        viewModel.onSharedText("apple, banana")
+
+        viewModel.confirmImport(packId)
+        awaitPhase(ExternalImportPhase.DONE)
+
+        assertThat(viewModel.state.value.result)
+            .isEqualTo(PackAddResult(inserted = 2, skipped = 0, total = 2))
+        val word = wordIn(packId, "apple")
+        assertThat(word).isNotNull()
+        assertThat(word!!.lookupState).isEqualTo("PENDING")
+        assertThat(word.meaningSource).isEmpty()
+        assertThat(countIn(packId)).isEqualTo(2)
+        assertThat(meaningSync.enqueues).isEqualTo(1)
+    }
+
+    @Test
+    fun `a second confirm tap while importing does not double import`() {
+        val packId = createTestPack()
+        viewModel.onSharedText("apple, banana")
+
+        viewModel.confirmImport(packId)
+        // The write suspends on Room, so the state is still IMPORTING here — a double tap.
+        assertThat(viewModel.state.value.phase).isEqualTo(ExternalImportPhase.IMPORTING)
+        viewModel.confirmImport(packId)
+        awaitPhase(ExternalImportPhase.DONE)
+
+        assertThat(viewModel.state.value.result)
+            .isEqualTo(PackAddResult(inserted = 2, skipped = 0, total = 2))
+        assertThat(countIn(packId)).isEqualTo(2)
+        assertThat(meaningSync.enqueues).isEqualTo(1)
+    }
+
+    @Test
+    fun `dismiss during an in-flight import is ignored`() {
+        val packId = createTestPack()
+        viewModel.onSharedText("apple")
+        viewModel.confirmImport(packId)
+
+        viewModel.dismiss()
+
+        // The write owns the state until it finishes; dismissing mid-flight must not strand it.
+        awaitPhase(ExternalImportPhase.DONE)
+        assertThat(countIn(packId)).isEqualTo(1)
+    }
+
+    @Test
+    fun `a failed write returns to the sheet with the repository error`() {
+        viewModel.onSharedText("apple")
+
+        viewModel.confirmImport("no-such-pack")
+
+        awaitCondition("back on DETECTED with the repository error") {
+            val state = viewModel.state.value
+            state.phase == ExternalImportPhase.DETECTED && state.error != null
+        }
+        assertThat(countIn("no-such-pack")).isEqualTo(0)
+        assertThat(meaningSync.enqueues).isEqualTo(0)
+    }
+
+    @Test
+    fun `createPackAndImport creates activates and imports in one flow`() {
+        viewModel.onSharedText("apple, banana")
+
+        viewModel.createPackAndImport("新词库")
+        awaitPhase(ExternalImportPhase.DONE)
+
+        awaitCondition("the new pack became the active study scope") {
+            storedSettings().activePackId.startsWith("user-")
+        }
+        val packId = storedSettings().activePackId
+        assertThat(
+            runBlocking(Dispatchers.IO) { database.wordDao().packById(packId) }!!.name,
+        ).isEqualTo("新词库")
+        assertThat(wordIn(packId, "banana")!!.lookupState).isEqualTo("PENDING")
+        assertThat(viewModel.state.value.result?.inserted).isEqualTo(2)
+        assertThat(meaningSync.enqueues).isEqualTo(1)
+    }
+
+    // --- clipboard hash bookkeeping ---------------------------------------------------------
+
+    @Test
+    fun `dismissing a clipboard detection records its hash`() {
+        viewModel.onClipboardText("apple")
+        assertThat(storedSettings().lastClipboardHash).isEmpty()
+
+        viewModel.dismiss()
+        awaitPhase(ExternalImportPhase.DISMISSED)
+
+        // "本次已看过" — the same content must never pop again (MainActivity compares).
+        awaitStoredHash(ClipboardHash.of("apple"))
+        assertThat(viewModel.isSheetVisible()).isFalse()
+    }
+
+    @Test
+    fun `dismissing a share never writes a clipboard hash`() {
+        viewModel.onSharedText("apple")
+
+        viewModel.dismiss()
+        awaitPhase(ExternalImportPhase.DISMISSED)
+
+        assertThat(storedSettings().lastClipboardHash).isEmpty()
+    }
+
+    @Test
+    fun `a completed clipboard import records its hash too`() {
+        val packId = createTestPack()
+        viewModel.onClipboardText("apple")
+
+        viewModel.confirmImport(packId)
+        awaitPhase(ExternalImportPhase.DONE)
+        awaitStoredHash(ClipboardHash.of("apple"))
+    }
+
+    // --- pack list --------------------------------------------------------------------------
+
+    @Test
+    fun `the selectable packs exclude the legacy bucket`() {
+        val packId = createTestPack("自定义库")
+        runBlocking(Dispatchers.IO) {
+            database.wordDao().upsertPack(
+                WordPackEntity(
+                    id = PackIds.LEGACY_OTHER,
+                    name = "历史归档",
+                    level = CetLevel.OTHER.id,
+                    isBuiltIn = false,
+                    wordCount = 0,
+                    createdAt = now,
+                    updatedAt = now,
+                ),
+            )
+        }
+
+        awaitCondition("the custom pack is visible") {
+            viewModel.packs.value.any { it.id == packId }
+        }
+        assertThat(viewModel.packs.value.map { it.id }).doesNotContain(PackIds.LEGACY_OTHER)
+    }
+
+    @Test
+    fun `the default pack follows the active pack setting`() {
+        awaitCondition("the builtin default is exposed before any choice") {
+            viewModel.activePackId.value == PackIds.BUILTIN_CET4
+        }
+
+        val packId = createTestPack("新库")
+        runBlocking(Dispatchers.IO) { container.settingsRepository.setActivePackId(packId) }
+
+        awaitCondition("the sheet default follows the learner's choice") {
+            viewModel.activePackId.value == packId
+        }
+    }
+
+    // --- hash function -----------------------------------------------------------------------
+
+    @Test
+    fun `ClipboardHash is stable trimmed and content sensitive`() {
+        // Well-known SHA-256 vector for "abc".
+        assertThat(ClipboardHash.of("abc"))
+            .isEqualTo("ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
+        // Normalisation is a trim: a round-tripped clipboard with a stray newline matches.
+        assertThat(ClipboardHash.of(" apple ")).isEqualTo(ClipboardHash.of("apple"))
+        assertThat(ClipboardHash.of("apple")).isNotEqualTo(ClipboardHash.of("apples"))
+        assertThat(ClipboardHash.of("apple")).isNotEqualTo(ClipboardHash.of("Apple"))
+    }
+
+    private companion object {
+        /** Real-time bound for Room / DataStore round-trips on a busy machine. */
+        const val TIMEOUT_MILLIS = 10_000L
+    }
+}
diff --git a/app/src/test/java/top/toneup/word/ui/GatewaySettingsTest.kt b/app/src/test/java/top/toneup/word/ui/GatewaySettingsTest.kt
new file mode 100644
index 0000000..8a5efb6
--- /dev/null
+++ b/app/src/test/java/top/toneup/word/ui/GatewaySettingsTest.kt
@@ -0,0 +1,162 @@
+package top.toneup.word.ui
+
+import android.content.Context
+import androidx.room.Room
+import androidx.test.core.app.ApplicationProvider
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import com.google.common.truth.Truth.assertThat
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.runBlocking
+import kotlinx.coroutines.test.resetMain
+import kotlinx.coroutines.test.setMain
+import org.junit.After
+import org.junit.Assert.fail
+import org.junit.Before
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.annotation.Config
+import top.toneup.word.AppContainer
+import top.toneup.word.data.gateway.GatewayDefaults
+import top.toneup.word.data.local.ToneUpWordDatabase
+import top.toneup.word.data.settings.DataStoreSettingsRepository
+import top.toneup.word.data.settings.UserSettings
+
+/**
+ * The gateway settings slice of [ProfileViewModel] (plan D7/§10).
+ *
+ * The rule under guard is "an invalid gateway address never reaches the repository":
+ * `http://` (or anything else that is not `https://`) must be rejected by the pure
+ * [gatewayUrlError] check *and* by the ViewModel setter, so no code path can persist a
+ * cleartext gateway even if the screen's inline validation is bypassed.
+ *
+ * The ViewModel's coroutines run on the real main dispatcher here (not a virtual-time test
+ * scheduler): a DataStore write only completes when its own IO scope finishes, so the
+ * assertions poll the persisted value instead of trusting a scheduler barrier.
+ */
+@RunWith(AndroidJUnit4::class)
+@Config(sdk = [26])
+class GatewaySettingsTest {
+
+    private lateinit var database: ToneUpWordDatabase
+    private lateinit var container: AppContainer
+    private lateinit var settings: DataStoreSettingsRepository
+
+    @Before
+    fun setUp() {
+        Dispatchers.setMain(Dispatchers.IO)
+        val context = ApplicationProvider.getApplicationContext<Context>()
+        database = Room.inMemoryDatabaseBuilder(context, ToneUpWordDatabase::class.java)
+            .allowMainThreadQueries()
+            .build()
+        container = AppContainer(context, database)
+        settings = DataStoreSettingsRepository(context)
+        // DataStore is shared between tests in the same process: start from a known state.
+        runBlocking { settings.resetToDefaults() }
+    }
+
+    @After
+    fun tearDown() {
+        database.close()
+        Dispatchers.resetMain()
+    }
+
+    // --- helpers ---------------------------------------------------------------------------
+
+    /**
+     * Polls the persisted settings until [predicate] holds (or fails after a real-time
+     * timeout). A DataStore write lands on its own IO scope, so no scheduler barrier can
+     * prove it finished — only a re-read can.
+     */
+    private suspend fun awaitStored(predicate: (UserSettings) -> Boolean) {
+        val deadline = System.currentTimeMillis() + TIMEOUT_MILLIS
+        while (System.currentTimeMillis() < deadline) {
+            if (predicate(settings.current())) return
+            delay(POLL_INTERVAL_MILLIS)
+        }
+        fail("the setting was not persisted within ${TIMEOUT_MILLIS}ms")
+    }
+
+    // --- gatewayUrlError (pure) --------------------------------------------------------------
+
+    @Test
+    fun `gatewayUrlError accepts https addresses and rejects everything else`() {
+        assertThat(gatewayUrlError(GatewayDefaults.BASE_URL)).isNull()
+        assertThat(gatewayUrlError("https://example.com")).isNull()
+        assertThat(gatewayUrlError("  https://example.com/  ")).isNull()
+
+        assertThat(gatewayUrlError("http://example.com")).isEqualTo("仅支持 https 地址")
+        assertThat(gatewayUrlError("example.com")).isEqualTo("仅支持 https 地址")
+        assertThat(gatewayUrlError("ftp://example.com")).isEqualTo("仅支持 https 地址")
+        assertThat(gatewayUrlError("")).isEqualTo("仅支持 https 地址")
+        assertThat(gatewayUrlError("   ")).isEqualTo("仅支持 https 地址")
+    }
+
+    // --- ProfileViewModel setters -------------------------------------------------------------
+
+    @Test
+    fun `an http gateway address is never persisted`() = runBlocking {
+        val viewModel = ProfileViewModel(container)
+
+        viewModel.setGatewayBaseUrl("http://insecure.example.com")
+        // The setter must not even enqueue a write; give any hypothetical coroutine time
+        // to (incorrectly) land, then assert the default is still stored.
+        delay(SETTLE_MILLIS)
+
+        assertThat(settings.current().gatewayBaseUrl).isEqualTo(GatewayDefaults.BASE_URL)
+    }
+
+    @Test
+    fun `an https gateway address is persisted trimmed`() = runBlocking {
+        val viewModel = ProfileViewModel(container)
+
+        viewModel.setGatewayBaseUrl("  https://my-gateway.example.com  ")
+        awaitStored { it.gatewayBaseUrl == "https://my-gateway.example.com" }
+
+        assertThat(settings.current().gatewayBaseUrl).isEqualTo("https://my-gateway.example.com")
+    }
+
+    @Test
+    fun `the gateway key and the completion toggles are written through`() = runBlocking {
+        val viewModel = ProfileViewModel(container)
+
+        viewModel.setGatewayKey("  rotated-key  ")
+        viewModel.setSyncOnlyUnmetered(true)
+        viewModel.setClipboardDetectEnabled(false)
+        awaitStored {
+            it.gatewayKey == "rotated-key" && it.syncOnlyUnmetered && !it.clipboardDetectEnabled
+        }
+
+        val stored = settings.current()
+        assertThat(stored.gatewayKey).isEqualTo("rotated-key")
+        assertThat(stored.syncOnlyUnmetered).isTrue()
+        assertThat(stored.clipboardDetectEnabled).isFalse()
+    }
+
+    @Test
+    fun `restoreGatewayDefaults brings address, key and paths back`() = runBlocking {
+        val viewModel = ProfileViewModel(container)
+        viewModel.setGatewayBaseUrl("https://my-gateway.example.com")
+        awaitStored { it.gatewayBaseUrl == "https://my-gateway.example.com" }
+        viewModel.setDictPath("/custom-dict")
+        awaitStored { it.dictPath == "/custom-dict" }
+
+        viewModel.restoreGatewayDefaults()
+        awaitStored {
+            it.gatewayBaseUrl == GatewayDefaults.BASE_URL &&
+                it.dictPath == GatewayDefaults.DICT_PATH
+        }
+
+        val stored = settings.current()
+        assertThat(stored.gatewayKey).isEqualTo(GatewayDefaults.KEY)
+        assertThat(stored.enPath).isEqualTo(GatewayDefaults.EN_PATH)
+        assertThat(stored.mtPath).isEqualTo(GatewayDefaults.MT_PATH)
+    }
+
+    private companion object {
+        const val TIMEOUT_MILLIS = 5_000L
+        const val POLL_INTERVAL_MILLIS = 50L
+        /** How long the "must not persist" test waits for a (forbidden) write to appear. */
+        const val SETTLE_MILLIS = 300L
+    }
+}
diff --git a/app/src/test/java/top/toneup/word/ui/speech/SpeechAudioRoutingTest.kt b/app/src/test/java/top/toneup/word/ui/speech/SpeechAudioRoutingTest.kt
new file mode 100644
index 0000000..3171d48
--- /dev/null
+++ b/app/src/test/java/top/toneup/word/ui/speech/SpeechAudioRoutingTest.kt
@@ -0,0 +1,329 @@
+package top.toneup.word.ui.speech
+
+import com.google.common.truth.Truth.assertThat
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.test.advanceUntilIdle
+import kotlinx.coroutines.test.runTest
+import org.junit.Test
+import top.toneup.word.data.speech.AudioPlayback
+import top.toneup.word.data.speech.SpeechContent
+import top.toneup.word.data.speech.SpeechRateMode
+import top.toneup.word.data.speech.SpeechRequest
+import top.toneup.word.data.speech.SpeechService
+import top.toneup.word.data.speech.SpeechStatus
+import top.toneup.word.domain.model.Word
+
+private const val AUDIO_URL = "https://cdn.example/audio/apple.mp3"
+
+/**
+ * Tests for the `audio_url` routing added by M6b: a word's own recording is played first, and
+ * every streaming failure falls back to system TTS *silently*.
+ *
+ * The word "silently" is the whole requirement, so it is asserted directly: the phases the button
+ * goes through are watched for the duration of a request and [SpeechPhase.FAILED] must never
+ * appear unless TTS itself failed. Nothing here touches Android or the network — the streamer is
+ * a fake behind [AudioPlayback], because `MediaPlayer` has no JVM behaviour to test.
+ */
+class SpeechAudioRoutingTest {
+
+    /** A scriptable engine, mirroring the one in [SpeechControllerTest]. */
+    private class FakeSpeechService(
+        initialStatus: SpeechStatus,
+    ) : SpeechService {
+        private val _status = MutableStateFlow(initialStatus)
+        override val status: StateFlow<SpeechStatus> = _status
+
+        var speakCount = 0
+            private set
+        var succeedOnSpeak = true
+
+        override fun speak(
+            request: SpeechRequest,
+            onStart: () -> Unit,
+            onDone: () -> Unit,
+            onError: (SpeechStatus) -> Unit,
+        ) {
+            speakCount++
+            if (succeedOnSpeak) {
+                onStart()
+                onDone()
+            } else {
+                onError(SpeechStatus.Failed(7))
+            }
+        }
+
+        override fun stop() = Unit
+
+        override fun release() = Unit
+    }
+
+    /** A scriptable streamer; every call is recorded so overlap with TTS can be proven absent. */
+    private class FakeAudioPlayback : AudioPlayback {
+        var playCount = 0
+            private set
+        var stopCount = 0
+            private set
+        var lastUrl: String? = null
+            private set
+
+        /** When false the stream "fails" after starting; when true it plays through. */
+        var succeeds = true
+
+        /** When true `play` throws, as a defensive test of the controller's catch-all. */
+        var throws = false
+
+        /** When set, `play` suspends until the test opens the gate (so PLAYING is observable). */
+        var gate: CompletableDeferred<Unit>? = null
+
+        override suspend fun play(url: String, onStart: () -> Unit): Boolean {
+            playCount++
+            lastUrl = url
+            if (throws) throw java.io.IOException("connection reset")
+            onStart()
+            gate?.await()
+            return succeeds
+        }
+
+        override fun stop() {
+            stopCount++
+        }
+    }
+
+    private val ready = SpeechStatus.Ready(
+        engine = "com.example.tts",
+        language = "en",
+        voice = "voice-1",
+        rateFromSystem = true,
+        pitchFromSystem = false,
+    )
+
+    private val word = Word(
+        id = 7L,
+        word = "apple",
+        exampleSentence = "An apple a day.",
+        audioUrl = AUDIO_URL,
+    )
+
+    private fun wordRequest(audioUrl: String = "") = SpeechRequest(
+        text = "apple",
+        localeTag = "en",
+        content = SpeechContent.WORD,
+        rateMode = SpeechRateMode.SYSTEM,
+        audioUrl = audioUrl,
+    )
+
+    // --- happy path: the recording wins ----------------------------------------
+
+    @Test
+    fun `a word with a recording plays it and never touches tts`() = runTest {
+        val service = FakeSpeechService(ready)
+        val player = FakeAudioPlayback()
+        val controller = SpeechController(service, this, audio = player)
+
+        controller.speak(wordRequest(audioUrl = AUDIO_URL))
+        advanceUntilIdle()
+
+        assertThat(player.playCount).isEqualTo(1)
+        assertThat(player.lastUrl).isEqualTo(AUDIO_URL)
+        assertThat(service.speakCount).isEqualTo(0)
+        assertThat(controller.state.value.phase).isEqualTo(SpeechPhase.IDLE)
+        assertThat(controller.state.value.message).isNull()
+    }
+
+    @Test
+    fun `online playback reports playing and then returns to idle`() = runTest {
+        val service = FakeSpeechService(ready)
+        val player = FakeAudioPlayback().apply { gate = CompletableDeferred() }
+        val controller = SpeechController(service, this, audio = player)
+
+        controller.speak(wordRequest(audioUrl = AUDIO_URL))
+        advanceUntilIdle()
+        // The recording is streaming: same loading→playing semantics as TTS.
+        assertThat(controller.state.value.phase).isEqualTo(SpeechPhase.PLAYING)
+        assertThat(service.speakCount).isEqualTo(0)
+
+        player.gate?.complete(Unit)
+        advanceUntilIdle()
+
+        assertThat(controller.state.value.phase).isEqualTo(SpeechPhase.IDLE)
+        assertThat(controller.state.value.message).isNull()
+        assertThat(service.speakCount).isEqualTo(0)
+    }
+
+    // --- silent fallback -------------------------------------------------------
+
+    @Test
+    fun `a failed recording silently falls back to tts and never shows failed`() = runTest {
+        val service = FakeSpeechService(ready)
+        val player = FakeAudioPlayback().apply { succeeds = false }
+        val controller = SpeechController(service, this, audio = player)
+
+        val phases = mutableListOf<SpeechPhase>()
+        val watcher = launch { controller.state.collect { phases += it.phase } }
+
+        controller.speak(wordRequest(audioUrl = AUDIO_URL))
+        advanceUntilIdle()
+        watcher.cancel()
+
+        // TTS took over and finished normally: no failure is ever shown for a dead recording.
+        assertThat(service.speakCount).isEqualTo(1)
+        assertThat(controller.state.value.phase).isEqualTo(SpeechPhase.IDLE)
+        assertThat(controller.state.value.message).isNull()
+        assertThat(phases).doesNotContain(SpeechPhase.FAILED)
+        assertThat(phases).contains(SpeechPhase.LOADING)
+    }
+
+    @Test
+    fun `a thrown streamer error also falls back to tts`() = runTest {
+        val service = FakeSpeechService(ready)
+        val player = FakeAudioPlayback().apply { throws = true }
+        val controller = SpeechController(service, this, audio = player)
+
+        controller.speak(wordRequest(audioUrl = AUDIO_URL))
+        advanceUntilIdle()
+
+        assertThat(player.playCount).isEqualTo(1)
+        assertThat(service.speakCount).isEqualTo(1)
+        assertThat(controller.state.value.phase).isEqualTo(SpeechPhase.IDLE)
+        assertThat(controller.state.value.message).isNull()
+    }
+
+    @Test
+    fun `an empty audio url goes straight to tts without touching the player`() = runTest {
+        val service = FakeSpeechService(ready)
+        val player = FakeAudioPlayback()
+        val controller = SpeechController(service, this, audio = player)
+
+        controller.speak(wordRequest(audioUrl = ""))
+        advanceUntilIdle()
+
+        assertThat(player.playCount).isEqualTo(0)
+        assertThat(service.speakCount).isEqualTo(1)
+        assertThat(controller.state.value.phase).isEqualTo(SpeechPhase.IDLE)
+    }
+
+    @Test
+    fun `a non-http scheme never reaches the player`() = runTest {
+        val service = FakeSpeechService(ready)
+        val player = FakeAudioPlayback()
+        val controller = SpeechController(service, this, audio = player)
+
+        // Rejected by the scheme check before any player is built → plain TTS. Each tap runs to
+        // completion before the next: a second `speak` cancels the in-flight request (by design,
+        // covered by the mutual-exclusion tests below), which would otherwise collapse two
+        // back-to-back taps into a single TTS call.
+        controller.speak(wordRequest(audioUrl = "ftp://cdn.example/apple.mp3"))
+        advanceUntilIdle()
+        controller.speak(wordRequest(audioUrl = "content://media/external/audio/1"))
+        advanceUntilIdle()
+
+        assertThat(player.playCount).isEqualTo(0)
+        assertThat(service.speakCount).isEqualTo(2)
+        assertThat(controller.state.value.phase).isEqualTo(SpeechPhase.IDLE)
+    }
+
+    // --- FAILED stays reserved for TTS -----------------------------------------
+
+    @Test
+    fun `when both the recording and tts fail the button still fails visibly`() = runTest {
+        val service = FakeSpeechService(ready).apply { succeedOnSpeak = false }
+        val player = FakeAudioPlayback().apply { succeeds = false }
+        val controller = SpeechController(service, this, audio = player)
+
+        controller.speak(wordRequest(audioUrl = AUDIO_URL))
+        advanceUntilIdle()
+
+        assertThat(player.playCount).isEqualTo(1)
+        assertThat(service.speakCount).isEqualTo(1)
+        assertThat(controller.state.value.phase).isEqualTo(SpeechPhase.FAILED)
+        assertThat(controller.state.value.recovery)
+            .isEqualTo(top.toneup.word.data.speech.SpeechRecovery.RETRY)
+    }
+
+    @Test
+    fun `retrying after a tts failure tries the recording again`() = runTest {
+        val service = FakeSpeechService(ready).apply { succeedOnSpeak = false }
+        val player = FakeAudioPlayback().apply { succeeds = false }
+        val controller = SpeechController(service, this, audio = player)
+
+        controller.speak(wordRequest(audioUrl = AUDIO_URL))
+        advanceUntilIdle()
+        assertThat(controller.state.value.phase).isEqualTo(SpeechPhase.FAILED)
+
+        service.succeedOnSpeak = true
+        player.succeeds = true
+        controller.retry()
+        advanceUntilIdle()
+
+        assertThat(player.playCount).isEqualTo(2)
+        assertThat(service.speakCount).isEqualTo(1) // the retry succeeded online, TTS not needed
+        assertThat(controller.state.value.phase).isEqualTo(SpeechPhase.IDLE)
+    }
+
+    // --- only the headword carries a recording ---------------------------------
+
+    @Test
+    fun `only the headword request carries the recording url`() {
+        assertThat(word.asSpeechRequest(SpeechRateMode.SYSTEM).audioUrl).isEqualTo(AUDIO_URL)
+        assertThat(word.exampleAsSpeechRequest(SpeechRateMode.SYSTEM).audioUrl).isEmpty()
+        assertThat(word.meaningAsSpeechRequest(SpeechRateMode.SYSTEM).audioUrl).isEmpty()
+    }
+
+    @Test
+    fun `an example sentence uses tts even when the word has a recording`() = runTest {
+        val service = FakeSpeechService(ready)
+        val player = FakeAudioPlayback()
+        val controller = SpeechController(service, this, audio = player)
+
+        controller.speak(word.exampleAsSpeechRequest(SpeechRateMode.SYSTEM))
+        advanceUntilIdle()
+
+        assertThat(player.playCount).isEqualTo(0)
+        assertThat(service.speakCount).isEqualTo(1)
+        assertThat(controller.state.value.phase).isEqualTo(SpeechPhase.IDLE)
+    }
+
+    // --- mutual exclusion ------------------------------------------------------
+
+    @Test
+    fun `stopping mid-recording stops the player and does not fall back to tts`() = runTest {
+        val service = FakeSpeechService(ready)
+        val player = FakeAudioPlayback().apply { gate = CompletableDeferred() }
+        val controller = SpeechController(service, this, audio = player)
+
+        controller.speak(wordRequest(audioUrl = AUDIO_URL))
+        advanceUntilIdle()
+        assertThat(controller.state.value.phase).isEqualTo(SpeechPhase.PLAYING)
+
+        controller.stop()
+        advanceUntilIdle()
+
+        assertThat(player.stopCount).isAtLeast(1)
+        assertThat(controller.state.value.phase).isEqualTo(SpeechPhase.IDLE)
+        // A cancelled request must never start talking again behind the learner's back.
+        assertThat(service.speakCount).isEqualTo(0)
+    }
+
+    @Test
+    fun `a second tap stops the streaming player before speaking the next word`() = runTest {
+        val service = FakeSpeechService(ready)
+        val player = FakeAudioPlayback().apply { gate = CompletableDeferred() }
+        val controller = SpeechController(service, this, audio = player)
+
+        controller.speak(wordRequest(audioUrl = AUDIO_URL))
+        advanceUntilIdle()
+        assertThat(controller.state.value.phase).isEqualTo(SpeechPhase.PLAYING)
+
+        player.gate = null // the next word has no recording of its own
+        controller.speak(wordRequest())
+        advanceUntilIdle()
+
+        assertThat(player.stopCount).isAtLeast(1)
+        assertThat(service.speakCount).isEqualTo(1)
+        assertThat(controller.state.value.phase).isEqualTo(SpeechPhase.IDLE)
+        assertThat(controller.state.value.content).isEqualTo(SpeechContent.WORD)
+    }
+}
