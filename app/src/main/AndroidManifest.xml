<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Permissions, and why each one exists:
      * INTERNET — for exactly two features, nothing else:
        1. the self-hosted definition-completion gateway (ECDICT / FreeDict / LLM forwarding)
           that fills in meanings, phonetics and parts of speech for user-imported words;
        2. the in-app update pipeline (fixed version.json + mirrored APK download + SHA-256
           verification, see data/update/ and data/repository/AppUpdateRepository.kt).
        Everything else — learning, review, the mistake book, closed-book exams, statistics,
        import/export and TTS read-aloud (device's own speech service) — still works with no
        network at all. No account system, analytics, ads or cloud sync is bundled; clipboard/
        share text never leaves the device (only the individual word token being queried is
        uploaded). Hard constraint source: docs/dev/PLAN_CUSTOM_PACKS_GATEWAY.md §1; AGENTS.md
        ANTI-PATTERNS.
      * POST_NOTIFICATIONS — study reminders on Android 13+ only; Android 8-12 need nothing.
      * REQUEST_INSTALL_PACKAGES — only to hand the downloaded update APK to the system
        installer; the app never installs anything silently, the user confirms every install
        in the system UI (plus the per-app "install unknown apps" grant on API 26+).

      ACCESS_NETWORK_STATE is not declared here either. It appears in the merged manifest only
      because androidx.work (study reminders, meaning-sync worker) declares it
      for its network constraints; a WorkManager NetworkType constraint (CONNECTED /
      UNMETERED "Wi-Fi only") needs no permission from us, and the app itself never reads
      connectivity state.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".ToneUpWordApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ToneUpWord">

        <!--
          Entry points (M5, plan §8.2):
          * MAIN/LAUNCHER — the ordinary cold-start icon.
          * ACTION_SEND (text/plain) — the system share sheet, so a word list picked in a
            browser / notes app lands straight in the import sheet.
          * ACTION_PROCESS_TEXT (text/plain) — the text-selection menu (浏览器「翻译/复制」),
            the fastest path from reading to importing.

          `singleTop` routes a second delivery into onNewIntent instead of stacking another
          activity on top of the current one; MainActivity consumes both filters through the
          same handleShareIntent() path. Label uses @string/app_name: res/values/strings.xml
          carries no dedicated share-sheet label (R4 in the plan; app_name is the whole app's
          identity in the system picker anyway).

          Privacy: shared text is parsed locally only — nothing is uploaded. The gateway
          receives individual word tokens, and only after the learner confirms the import.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.ToneUpWord">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
          Serves the downloaded update APK to the system installer (in-app update pipeline).
          `exported=false` + `grantUriPermissions`: the URI is handed out per-intent with
          FLAG_GRANT_READ_URI_PERMISSION only, and only for the cache/updates/ path
          (res/xml/file_paths.xml). The authority uses ${applicationId} so the debug suffix
          (.debug) gets its own provider automatically.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
