<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标（API 26+；本应用 minSdk 26，所以所有设备都走这条路径）。
  前景是「上岸水环」整幅作品，自带圆角透明边，铺满 108dp 画布：水环与 ToneUp 字标都落在
  可见区的中心圆内，圆形 / 圆角方形遮罩下均不会被裁切；透明圆角处透出同为深蓝紫色的背景色，
  两者同色，不会出现接缝。单色层供 Android 13+ 主题图标使用，由同一作品按与背景色的色差
  提取亮部轮廓生成，颜色交给系统着色。位图按 mdpi–xxxhdpi 五档密度提供，见 res/mipmap-*。
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
